# Normalize all text files to LF in the repo (and on checkout) so commits stop
# emitting CRLF<->LF warnings on Windows. Binaries are excluded below.
* text=auto eol=lf

# Common binary assets - never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.7z    binary
*.so    binary
*.dll   binary
